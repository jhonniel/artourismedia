# Docker production environment
# Copy to repo root: cp .env.docker.example .env.docker

APP_NAME="Art Boncato Tourism Consultancy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

FRONTEND_URL=https://yourdomain.com
ADMIN_URL=https://yourdomain.com/admin

# --- Database ---
# Bundled Postgres (docker compose --profile bundled-db):
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=destination_studio
DB_USERNAME=destination_user
DB_PASSWORD=change-me-to-a-strong-password

# DigitalOcean Managed PostgreSQL (omit bundled-db profile):
# DB_HOST=your-db.db.ondigitalocean.com
# DB_PORT=25060
# DB_SSLMODE=require

# --- Redis (Docker service name) ---
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

SESSION_DOMAIN=yourdomain.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage (DigitalOcean Spaces — all uploads) ---
FILESYSTEM_DISK=spaces
DIGITALOCEAN_SPACES_KEY=
DIGITALOCEAN_SPACES_SECRET=
DIGITALOCEAN_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DIGITALOCEAN_SPACES_REGION=sgp1
DIGITALOCEAN_SPACES_BUCKET=
DIGITALOCEAN_SPACES_PATH=https://your-bucket.sgp1.digitaloceanspaces.com
DIGITALOCEAN_SPACES_ROOT_PATH=art-website
DIGITALOCEAN_SPACES_EXPIRATION=30

# Local disk only (not recommended for production):
# FILESYSTEM_DISK=public

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me

# --- Deploy flags ---
RUN_MIGRATIONS=true
RUN_SEED=false

# --- Host port for nginx ---
HTTP_PORT=80
