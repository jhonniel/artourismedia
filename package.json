{
  "name": "destination-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "dev": "node scripts/start-local.mjs",
    "dev:network": "node scripts/start-local.mjs",
    "network:firewall": "powershell -ExecutionPolicy Bypass -File scripts/open-network-firewall.ps1",
    "build": "node scripts/build-production.mjs",
    "build:production": "node scripts/build-production.mjs",
    "build:deploy": "node scripts/build-deploy.mjs",
    "assets:upload": "node scripts/upload-static-assets.mjs",
    "assets:verify": "node scripts/verify-static-assets.mjs",
    "assets:verify-cdn": "node scripts/verify-cdn-assets.mjs",
    "assets:verify-api": "node scripts/verify-api-assets.mjs",
    "assets:verify-all": "node scripts/verify-static-assets.mjs && node scripts/verify-api-assets.mjs && node scripts/verify-cdn-assets.mjs",
    "hero:import": "node scripts/import-hero-slideshow.mjs",
    "start": "node scripts/start-production.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:prepare": "node scripts/e2e-prepare-backend.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
